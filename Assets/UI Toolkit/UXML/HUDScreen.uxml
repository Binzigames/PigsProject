<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="PauseScreen" src="project://database/Assets/UI%20Toolkit/UXML/PauseScreen.uxml?fileID=9197481963319205126&amp;guid=f13ecbfe5a5f79a4eaa524542b3cbaca&amp;type=3#PauseScreen"/>
    <ui:Template name="ResultScreen" src="project://database/Assets/UI%20Toolkit/UXML/ResultScreen.uxml?fileID=9197481963319205126&amp;guid=a8afa9ec1e5fb004b8752d270d58f171&amp;type=3#ResultScreen"/>
    <Style src="project://database/Assets/UI%20Toolkit/Sheets/HUDStyleSheet.uss?fileID=7433441132597879392&amp;guid=e122969a2cb51ba4ba611d0b76a5cf47&amp;type=3#HUDStyleSheet"/>
    <ui:VisualElement name="HUDElements" style="flex-grow: 1;">
        <ui:Button name="pause-button" class="pause-button" style="height: 109px; width: 106px; flex-shrink: 0; background-color: rgba(188, 188, 188, 0); margin-right: 50px; position: absolute; right: 0; top: 75px; border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0);"/>
        <ui:VisualElement name="hud__score-panel" class="counter-label" style="background-color: rgba(229, 229, 229, 0); font-size: 96px; width: 330px; top: 75px; position: absolute; right: 0; left: 380px; -unity-font-definition: url(&quot;project://database/Assets/Visuals/Fonts/LilitaOne-Regular.ttf?fileID=12800000&amp;guid=7bf66073856ae40a1875549e19ef7770&amp;type=3#LilitaOne-Regular&quot;); color: rgb(255, 255, 255); -unity-text-outline-width: 1px; height: 110px; justify-content: center; -unity-text-outline-color: rgb(0, 0, 0); -unity-background-image-tint-color: rgb(255, 0, 0); align-items: center;">
            <ui:Label text="0" name="score-label" style="-unity-text-align: upper-center; margin-top: 5px; font-size: 59px; -unity-text-outline-width: 0; -unity-text-generator: advanced; -unity-text-auto-size: best-fit 40px 60px; width: 181px;"/>
        </ui:VisualElement>
        <ui:VisualElement name="hud__currency-panel" class="counter-label" style="background-color: rgba(229, 229, 229, 0); font-size: 96px; width: 170px; margin-left: 50px; left: 0; top: 95px; position: absolute; -unity-font-definition: url(&quot;project://database/Assets/Visuals/Fonts/LilitaOne-Regular.ttf?fileID=12800000&amp;guid=7bf66073856ae40a1875549e19ef7770&amp;type=3#LilitaOne-Regular&quot;); color: rgb(255, 255, 255); -unity-text-outline-width: 1px; height: 60px; -unity-text-outline-color: rgb(0, 0, 0); justify-content: center; white-space: normal; -unity-background-image-tint-color: rgb(255, 198, 0);">
            <ui:Image name="carrot-image" style="position: absolute; background-image: url(&quot;project://database/Assets/Visuals/UI/Slide%2016_9%20-%201%20(5).png?fileID=263767234&amp;guid=e376f57c569ef4439a67fc68500f6401&amp;type=3#Slide 16_9 - 1 (5)_13&quot;); -unity-background-scale-mode: scale-to-fit; height: 63px; top: -4px; width: 67px; left: -1px; -unity-background-image-tint-color: rgba(255, 255, 255, 0.9);"/>
            <ui:Label text="0" name="currency-label" style="-unity-text-align: upper-center; font-size: 45px; -unity-font-style: normal; white-space: nowrap; align-self: flex-end; position: absolute; left: 65px; -unity-font-definition: url(&quot;project://database/Assets/Visuals/Fonts/LilitaOne-Regular.ttf?fileID=12800000&amp;guid=7bf66073856ae40a1875549e19ef7770&amp;type=3#LilitaOne-Regular&quot;); -unity-text-outline-color: rgba(0, 0, 0, 0); -unity-text-outline-width: 0; width: 97px; -unity-text-auto-size: best-fit 30px 47px; -unity-text-generator: advanced;"/>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:Instance template="PauseScreen" name="PauseScreen" style="display: none;"/>
    <ui:Instance template="ResultScreen" name="ResultScreen" style="display: none;"/>
</ui:UXML>
