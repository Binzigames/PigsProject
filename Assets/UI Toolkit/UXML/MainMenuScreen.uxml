<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="SettingsScreen" src="project://database/Assets/UI%20Toolkit/UXML/SettingsScreen.uxml?fileID=9197481963319205126&amp;guid=3d051a4ab0234d541b5669e8541b8f3d&amp;type=3#SettingsScreen"/>
    <Style src="project://database/Assets/UI%20Toolkit/Sheets/MainMenuStyleSheet.uss?fileID=7433441132597879392&amp;guid=42eb6303ced98fa41a14eef78ce2893e&amp;type=3#MainMenuStyleSheet"/>
    <ui:VisualElement name="UpperBox" class="upper-panel" style="background-size: 105% 105%; height: 200px; width: 1109px;">
        <ui:VisualElement name="HighScorePanel" class="high_score-panel" style="background-color: rgba(255, 255, 255, 0); background-image: url(&quot;project://database/Assets/Visuals/UI/Slide%2016_9%20-%201%20(5).png?fileID=512703252&amp;guid=e376f57c569ef4439a67fc68500f6401&amp;type=3#Slide 16_9 - 1 (5)_4&quot;); top: 438px; left: 575px; width: 460px; height: 284px; -unity-background-scale-mode: scale-and-crop; translate: 0 -245px;">
            <ui:Label text="HIGH SCORE&#10;" style="font-size: 50px; -unity-text-align: upper-center; bottom: -40px; -unity-font-definition: url(&quot;project://database/Assets/Visuals/Fonts/LilitaOne-Regular.ttf?fileID=12800000&amp;guid=7bf66073856ae40a1875549e19ef7770&amp;type=3#LilitaOne-Regular&quot;); color: rgb(255, 226, 0); text-shadow: 0 4.1px 2.2px rgba(0, 0, 0, 0.78);"/>
            <ui:Label text="000&#10;" name="best_score-label" style="font-size: 49px; -unity-text-align: middle-center; background-image: url(&quot;project://database/Assets/Visuals/UI/Slide%2016_9%20-%201%20(5).png?fileID=1894781151&amp;guid=e376f57c569ef4439a67fc68500f6401&amp;type=3#Slide 16_9 - 1 (5)_2&quot;); width: 326px; height: 95px; position: relative; flex-shrink: 0; flex-direction: column; flex-grow: 0; align-items: auto; align-self: center; top: 61px; -unity-font-definition: url(&quot;project://database/Assets/Visuals/Fonts/LilitaOne-Regular.ttf?fileID=12800000&amp;guid=7bf66073856ae40a1875549e19ef7770&amp;type=3#LilitaOne-Regular&quot;); color: rgb(255, 255, 255);"/>
        </ui:VisualElement>
        <ui:VisualElement name="total_money-panel" class="count-panel" style="top: 112px; left: 51px;">
            <ui:Label text="000" name="money-label" style="flex-grow: 0; -unity-text-align: middle-right; font-size: 32px; -unity-font-style: normal; -unity-font-definition: url(&quot;project://database/Assets/Visuals/Fonts/LilitaOne-Regular.ttf?fileID=12800000&amp;guid=7bf66073856ae40a1875549e19ef7770&amp;type=3#LilitaOne-Regular&quot;); color: rgb(255, 255, 255); white-space: nowrap; width: 94px; align-self: flex-end; right: 14px; top: 1px;"/>
            <ui:Image style="background-image: url(&quot;project://database/Assets/Visuals/UI/Slide%2016_9%20-%201%20(5).png?fileID=263767234&amp;guid=e376f57c569ef4439a67fc68500f6401&amp;type=3#Slide 16_9 - 1 (5)_13&quot;); width: 54px; height: 45px; position: absolute; top: 7px; left: 9px;"/>
        </ui:VisualElement>
        <ui:Button text="" name="SettingsButton" enabled="true" style="width: 71px; height: 72px; position: absolute; top: 99px; left: 962px; background-color: rgba(188, 188, 188, 0); background-image: url(&quot;project://database/Assets/Visuals/UI/Slide%2016_9%20-%201%20(5).png?fileID=-638001256&amp;guid=e376f57c569ef4439a67fc68500f6401&amp;type=3#Slide 16_9 - 1 (5)_3&quot;); -unity-slice-type: tiled; aspect-ratio: auto; -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: rgb(255, 255, 255); border-top-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); border-left-color: rgba(149, 149, 149, 0);"/>
    </ui:VisualElement>
    <ui:Button text="" name="PlayButton" class="button" style="bottom: 0; flex-grow: 1; flex-shrink: 0; font-size: 82px; -unity-text-align: middle-center; -unity-font-style: bold; background-color: rgba(188, 188, 188, 0); -unity-font-definition: url(&quot;project://database/Assets/Visuals/Fonts/LilitaOne-Regular.ttf?fileID=12800000&amp;guid=7bf66073856ae40a1875549e19ef7770&amp;type=3#LilitaOne-Regular&quot;); color: rgb(255, 162, 0); -unity-text-outline-width: 2px; -unity-text-outline-color: rgb(0, 0, 0); text-shadow: 0 7.4px 0 rgb(0, 0, 0); -unity-text-auto-size: none; border-top-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); border-left-color: rgba(149, 149, 149, 0);">
        <ui:Label text="TAB TO ESCAPE" style="top: 666px; -unity-text-align: middle-center; bottom: 0; left: 0; right: 0; position: absolute;"/>
    </ui:Button>
    <ui:Instance template="SettingsScreen" name="SettingsScreen" enabled="true" style="position: absolute; right: 0; left: 0; background-color: rgb(50, 205, 50); display: none; visibility: visible;"/>
</ui:UXML>
