    </ui:GroupBox>
    <ui:Label text="V.0.0.0 (23.04.2026)&#10;" name="GameVersion" style="flex-grow: 1; -unity-text-align: lower-center; margin-top: 94px; margin-right: 94px; margin-bottom: 94px; margin-left: 94px; font-size: 36px; -unity-font-style: bold;"/>
