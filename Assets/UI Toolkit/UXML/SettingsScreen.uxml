<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/Sheets/SettingsStyleSheet.uss?fileID=7433441132597879392&amp;guid=2ff81459934e22a46ae3341df74c7884&amp;type=3#SettingsStyleSheet"/>
    <ui:VisualElement style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Visuals/UI/Slide%2016_9%20-%201%20(5).png?fileID=-107725982&amp;guid=e376f57c569ef4439a67fc68500f6401&amp;type=3#Slide 16_9 - 1 (5)_1&quot;); background-size: 110% 110%; flex-shrink: 1; height: 292px;">
        <ui:Label text="SETTINGS" enabled="true" style="-unity-text-align: lower-center; -unity-font-style: normal; font-size: 60px; -unity-font-definition: url(&quot;project://database/Assets/Visuals/Fonts/LilitaOne-Regular.ttf?fileID=12800000&amp;guid=7bf66073856ae40a1875549e19ef7770&amp;type=3#LilitaOne-Regular&quot;); color: rgb(255, 255, 255); text-shadow: 0 8.900001px 0 rgb(0, 0, 0); -unity-text-outline-width: 0; text-overflow: clip; top: 121px;"/>
        <ui:Button name="ExitSettingsButton" style="position: absolute; background-color: rgba(188, 188, 188, 0); background-image: url(&quot;project://database/Assets/Visuals/UI/Slide%2016_9%20-%201%20(5).png?fileID=-1954855962&amp;guid=e376f57c569ef4439a67fc68500f6401&amp;type=3#Slide 16_9 - 1 (5)_9&quot;); border-top-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-left-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); -unity-background-scale-mode: scale-and-crop; height: 109px; width: 106px; top: 112px; left: 936px;"/>
    </ui:VisualElement>
    <ui:GroupBox enabled="true" picking-mode="Ignore" focusable="false" name="GroupBox" style="flex-direction: column; align-items: center; justify-content: flex-start; height: 1454px; align-content: auto;">
        <ui:Toggle label="" name="SoundToggle" enabled="true" value="true" class="toggle-settings" style="height: 12%; justify-content: space-between; align-items: center; flex-direction: row; align-self: center; top: 242px; width: 60%;">
            <ui:Image name="sound-checker" class="toggle-image__checkmark toggle-image_checked" style="display: flex;"/>
            <ui:Label text="Sound" class="label-button" style="left: -260px;"/>
        </ui:Toggle>
        <ui:Toggle label="" name="MusicToggle" value="true" class="toggle-settings" style="height: 12%; justify-content: space-between; align-items: center; flex-direction: row; align-self: center; top: 242px; width: 60%;">
            <ui:Image name="music-checker" class="toggle-image__checkmark toggle-image_checked"/>
            <ui:Label text="Music" class="label-button"/>
        </ui:Toggle>
        <ui:Toggle label="" name="HapticToggle" value="true" class="toggle-settings" style="height: 12%; justify-content: space-between; align-items: center; flex-direction: row; align-self: center; top: 242px; width: 60%;">
            <ui:Image name="haptic-checker" class="toggle-image__checkmark toggle-image_checked"/>
