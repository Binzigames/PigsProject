:root {
}

.upper-panel {
    flex-grow: 0;
    position: relative;
    height: 453px;
    width: 1076px;
    flex-shrink: 0;
    display: flex;
    background-image: url("project://database/Assets/Visuals/UI/Slide%2016_9%20-%201%20(5).png?fileID=-107725982&guid=e376f57c569ef4439a67fc68500f6401&type=3#Slide 16_9 - 1 (5)_1");
}

.count-panel {
    flex-grow: 1;
    position: absolute;
    height: 57px;
    width: 176px;
    top: 164px;
    left: 551px;
    background-color: rgba(175, 175, 175, 0);
    background-image: url("project://database/Assets/Visuals/UI/Slide%2016_9%20-%201%20(5).png?fileID=1894781151&guid=e376f57c569ef4439a67fc68500f6401&type=3#Slide 16_9 - 1 (5)_2");
    aspect-ratio: auto;
    -unity-background-scale-mode: scale-and-crop;
}

.high_score-panel {
    flex-grow: 1;
    position: absolute;
    height: 128px;
    width: 477px;
    background-color: rgba(255, 255, 255, 0.51);
    top: 284px;
    left: 544px;
}

.settings-button {
    width: 71px;
    height: 72px;
    background-color: rgba(188, 188, 188, 0);
    background-image: url("project://database/Assets/Visuals/UI/Slide%2016_9%20-%201%20(5).png?fileID=-638001256&guid=e376f57c569ef4439a67fc68500f6401&type=3#Slide 16_9 - 1 (5)_3");
    -unity-slice-type: tiled;
    aspect-ratio: auto;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    border-top-color: rgba(149, 149, 149, 0);
    border-right-color: rgba(149, 149, 149, 0);
    border-bottom-color: rgba(149, 149, 149, 0);
    border-left-color: rgba(149, 149, 149, 0);
    color: rgb(27, 27, 27);
    white-space: nowrap;
    position: absolute;
    top: 100px;
    right: 60px;
    transition-duration: 0.08s;
}

.settings-button:active {
    width: 71px;
    height: 72px;
    background-color: rgba(188, 188, 188, 0);
    background-image: url("project://database/Assets/Visuals/UI/Slide%2016_9%20-%201%20(5).png?fileID=-638001256&guid=e376f57c569ef4439a67fc68500f6401&type=3#Slide 16_9 - 1 (5)_3");
    -unity-slice-type: tiled;
    aspect-ratio: auto;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    border-top-color: rgba(149, 149, 149, 0);
    border-right-color: rgba(149, 149, 149, 0);
    border-bottom-color: rgba(149, 149, 149, 0);
    border-left-color: rgba(149, 149, 149, 0);
    color: rgb(27, 27, 27);
    white-space: nowrap;
    position: absolute;
    top: 100px;
    right: 60px;
    scale: 1.2 1.2 1.2;
    transition-duration: 0.08s;
    transition-timing-function: ease-out;
}
